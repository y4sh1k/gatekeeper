# Gatekeeper v2 (Vercel) — copy to .env for local dev
# 64+ hex chars. Generate with: openssl rand -hex 32
# This signs every ticket. Keep it secret, keep it safe — losing it invalidates
# all issued passes.
GATEKEEPER_SECRET=

# Vercel KV (Redis) — auto-filled on Vercel when you connect KV storage.
# For local dev, paste the values from Vercel → Storage → your KV → .env.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Local dev without any network: use the in-memory backend instead.
# GK_MEMORY_STORE=1

PORT=3000
